{
  "AuthProtection": {
    "MaxFailedAttemptsPerIdentity": 5,
    "MaxFailedAttemptsPerClient": 20,
    "FailedAttemptWindowMinutes": 15,
    "LockoutMinutes": 15,
    "CooldownSeconds": 2
  },
  "SecurityRateLimits": {
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "SensitiveAdmin": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}