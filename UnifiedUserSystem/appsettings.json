{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Ssl Mode=Disable"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_ENV_OR_USER_SECRET",
    "Issuer": "UnifiedUserSystem",
    "Audience": "UnifiedUserSystemClient",
    "ExpiresMinutes": 15
  },
  "RefreshToken": {
    "ExpiresDays": 7,
    "TokenSizeBytes": 64
  },
  "AuthProtection": {
    "MaxFailedAttemptsPerIdentity": 5,
    "MaxFailedAttemptsPerClient": 20,
    "FailedAttemptWindowMinutes": 15,
    "LockoutMinutes": 15,
    "CooldownSeconds": 2
  },
  "SecurityRateLimits": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "SensitiveAdmin": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "PermissionEvaluation": {
    "CacheTtlSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
